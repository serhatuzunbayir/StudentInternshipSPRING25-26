@model StudentWeb.Models.ResumeViewModel

@{
    ViewData["Title"] = "Resume Builder";
}

<!-- Load Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

<style>
    /* Main Dashboard Layout */
    .cv-layout-wrapper {
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 1.5rem;
        align-items: start;
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 1rem;
    }

    /* Left Control Panel */
    .cv-customizer-panel {
        background: #ffffff;
        border: 1px solid var(--line);
        border-radius: 20px;
        padding: 1.75rem;
        max-height: calc(100vh - 7rem);
        overflow-y: auto;
        box-shadow: 0 10px 30px rgba(31, 41, 51, 0.04);
        position: sticky;
        top: 5.5rem;
    }

    .cv-customizer-panel::-webkit-scrollbar {
        width: 6px;
    }
    .cv-customizer-panel::-webkit-scrollbar-thumb {
        background-color: var(--line);
        border-radius: 99px;
    }

    .cv-panel-header {
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
        padding-bottom: 0.75rem;
    }

    .cv-panel-header h2 {
        margin: 0 0 0.25rem;
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -0.02em;
    }

    .cv-panel-header p {
        margin: 0;
        color: var(--muted);
        font-size: 0.88rem;
    }

    /* Group Sections */
    .cv-group {
        margin-bottom: 1.5rem;
    }

    .cv-group-title {
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        margin-bottom: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .cv-group-title::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--line);
    }

    /* Font Selector */
    .font-picker-flex {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .font-btn {
        flex: 1;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 0.6rem 0.5rem;
        text-align: center;
        cursor: pointer;
        font-size: 0.82rem;
        font-weight: 600;
        background: #ffffff;
        transition: all 0.2s ease;
    }

    .font-btn:hover {
        background: #f8fafc;
        border-color: var(--muted);
    }

    .font-btn.active {
        background: var(--ink);
        color: #ffffff;
        border-color: var(--ink);
        box-shadow: 0 4px 10px rgba(31, 41, 51, 0.15);
    }

    /* Form Controls (Strictly Stacked Vertically / Alt Alta) */
    .cv-control-group {
        margin-bottom: 1.25rem;
    }

    .cv-control-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 0.35rem;
        font-size: 0.85rem;
        color: var(--ink);
    }

    .cv-control-group input, 
    .cv-control-group textarea {
        width: 100%;
        padding: 0.65rem 0.85rem;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: #ffffff;
        color: var(--ink);
        font-size: 0.9rem;
        font-family: inherit;
        transition: all 0.2s ease;
    }

    .cv-control-group input:focus, 
    .cv-control-group textarea:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-soft);
    }

    .cv-control-group textarea {
        min-height: 95px;
        resize: vertical;
    }

    .cv-control-tip {
        font-size: 0.74rem;
        color: var(--muted);
        margin-top: 0.25rem;
        display: block;
        line-height: 1.4;
    }

    /* Actions */
    .action-buttons {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.25rem;
        border-top: 1px solid var(--line);
        padding-top: 1.25rem;
    }

    .action-btn {
        flex: 1;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.92rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .action-btn:hover {
        transform: translateY(-1px);
    }

    .action-btn-primary {
        background: var(--accent);
        color: #ffffff;
    }

    .action-btn-primary:hover {
        background: #0d635c;
        box-shadow: 0 4px 15px rgba(15, 118, 110, 0.2);
    }

    .action-btn-secondary {
        background: #f1f5f9;
        color: var(--ink);
        border: 1px solid var(--line);
    }

    .action-btn-secondary:hover {
        background: #e2e8f0;
    }

    /* Right Preview Window */
    .cv-preview-container {
        background: #cbd5e1;
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 1.5rem;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        overflow-y: auto;
        overflow-x: auto;
        max-height: calc(100vh - 7rem);
        box-shadow: inset 0 2px 10px rgba(0,0,0,0.06);
    }

    /* A4 Paper Styling with CSS Zoom for responsive preview rendering */
    .cv-sheet {
        width: 210mm;
        min-height: 297mm;
        background: #ffffff;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.15);
        box-sizing: border-box;
        position: relative;
        zoom: 0.68; /* Scale A4 sheet beautifully on laptop monitors */
        padding: 20mm 20mm;

        /* Default CV Variables (Classic Theme Colors) */
        --primary: #0f172a;
        --muted: #475569;
        --text: #334155;
        --line: #e2e8f0;
    }

    /* Fonts classes on sheet */
    .cv-sheet.font-sans {
        font-family: 'Inter', -apple-system, sans-serif;
    }
    .cv-sheet.font-serif {
        font-family: 'Playfair Display', Georgia, serif;
    }
    .cv-sheet.font-mono {
        font-family: 'Fira Code', Consolas, monospace;
    }

    /* CV Elements */
    .cv-sheet h1, .cv-sheet h2, .cv-sheet h3, .cv-sheet h4 {
        margin: 0;
        color: var(--primary);
    }

    .cv-sheet p {
        margin: 0 0 0.5rem 0;
        line-height: 1.5;
        font-size: 0.92rem;
        color: var(--text);
    }

    .cv-sheet ul.cv-list {
        margin: 0.25rem 0 0.5rem 0;
        padding-left: 1.25rem;
        line-height: 1.5;
        font-size: 0.92rem;
        color: var(--text);
    }

    .cv-sheet ul.cv-list li {
        margin-bottom: 0.25rem;
    }

    .cv-para {
        margin: 0 0 0.6rem;
    }

    .cv-spacing {
        height: 0.8rem;
    }

    /* CLASSIC HEADER STYLE (Matching reference image) */
    .cv-header {
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .cv-name {
        font-size: 2.3rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.2rem;
        color: #000000;
    }

    .cv-job-title {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--muted);
        margin-bottom: 0.5rem;
    }

    .cv-contact-row {
        font-size: 0.88rem;
        color: var(--text);
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        align-items: center;
    }

    .cv-divider {
        border: 0;
        border-top: 1px solid var(--line);
        margin: 0.75rem 0;
    }

    /* SECTION STYLE (Alt Alta / Vertically Stacked) */
    .cv-section {
        margin-bottom: 1.5rem;
    }

    .cv-section-title {
        font-size: 1rem;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-align: center;
        color: var(--primary);
        margin-bottom: 0.75rem;
        margin-top: 0.75rem;
    }

    /* Entry line item layout (Title, Date, Subtitle) */
    .cv-entry-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-size: 0.95rem;
        margin-bottom: 0.15rem;
    }

    .cv-entry-title {
        font-weight: 700;
        color: var(--primary);
    }

    .cv-entry-date {
        color: var(--muted);
        font-size: 0.88rem;
    }

    .cv-entry-subtitle {
        font-style: italic;
        color: var(--muted);
        font-size: 0.9rem;
        margin-bottom: 0.4rem;
    }

    /* Centered skills separated by dots */
    .cv-skills-centered {
        text-align: center;
        font-size: 0.92rem;
        color: var(--text);
        line-height: 1.6;
    }

    /* Print-specific layout override */
    @@media print {
        body {
            background: #ffffff !important;
        }
        .site-header, 
        .page-shell,
        .cv-customizer-panel,
        .cv-preview-container {
            display: none !important;
            padding: 0 !important;
            margin: 0 !important;
            box-shadow: none !important;
        }

        .cv-layout-wrapper {
            display: block !important;
            padding: 0 !important;
            margin: 0 !important;
            max-width: 100% !important;
        }

        .cv-sheet {
            display: block !important;
            width: 210mm !important;
            height: 297mm !important;
            padding: 20mm !important;
            border: none !important;
            box-shadow: none !important;
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            margin: 0 !important;
            zoom: 1 !important; /* Reset zoom for high res native prints */
        }

        @@page {
            size: A4;
            margin: 0;
        }
    }

    /* Tablet and Mobile Optimization */
    @@media (max-width: 1024px) {
        .cv-layout-wrapper {
            grid-template-columns: 1fr;
        }
        .cv-customizer-panel {
            position: relative;
            top: 0;
            max-height: none;
        }
        .cv-preview-container {
            max-height: none;
            overflow-x: auto;
            justify-content: center;
        }
        .cv-sheet {
            zoom: 0.75;
        }
    }

    @@media (max-width: 600px) {
        .cv-sheet {
            zoom: 0.5;
        }
    }
</style>

<div class="cv-layout-wrapper">
    <!-- Left Pane: Settings & Control Panel -->
    <div class="cv-customizer-panel">
        <div class="cv-panel-header">
            <h2>Resume Customizer</h2>
            <p>Design and customize your resume in real-time.</p>
        </div>

        <!-- 1. Layout & Theme Options -->
        <div class="cv-group">
            <span class="cv-group-title">1. Typography</span>
            
            <div class="cv-control-group">
                <label style="font-weight:600; font-size:0.85rem; display:block; margin-bottom:0.35rem;">Font Family</label>
                <div class="font-picker-flex">
                    <div class="font-btn" onclick="selectFont('font-sans', this)">Sans</div>
                    <div class="font-btn active" onclick="selectFont('font-serif', this)">Serif</div>
                    <div class="font-btn" onclick="selectFont('font-mono', this)">Mono</div>
                </div>
            </div>
        </div>

        <!-- 2. Contact Details -->
        <div class="cv-group">
            <span class="cv-group-title">2. Personal Information</span>
            
            <div class="cv-control-group">
                <label>Full Name</label>
                <input type="text" id="input-fullname" value="@Model.FullName" placeholder="e.g. John Doe" />
            </div>

            <div class="cv-control-group">
                <label>Job Title</label>
                <input type="text" id="input-jobtitle" value="Student" placeholder="e.g. Software Engineer Intern" />
            </div>

            <div class="cv-control-group">
                <label>Address</label>
                <input type="text" id="input-address" value="Izmir, Turkey" placeholder="e.g. 123 Your Street, Your City" />
            </div>

            <div class="cv-control-group">
                <label>Email Address</label>
                <input type="email" id="input-email" value="@Model.Email" placeholder="e.g. john.doe@example.com" />
            </div>

            <div class="cv-control-group">
                <label>Phone Number</label>
                <input type="text" id="input-phone" value="@Model.Phone" placeholder="e.g. +90 555 123 4567" />
            </div>
        </div>

        <!-- 3. Professional Details -->
        <div class="cv-group">
            <span class="cv-group-title">3. Content Sections</span>
            
            <div class="cv-control-group">
                <label>Summary</label>
                <textarea id="input-aboutme" placeholder="Introduce yourself, your career path and aspirations...">@Model.AboutMe</textarea>
            </div>

            <div class="cv-control-group">
                <label>Experience</label>
                <textarea id="input-experience" placeholder="e.g. - Software Dev Intern at X Corp (Jan 2025 - Jun 2025)&#10;> Developed web features...&#10;> Managed SQL database...&#10;- QA Intern at Y Corp (Jan 2024 - Dec 2024)...">@Model.Experience</textarea>
                <span class="cv-control-tip">
                    <strong>Tip:</strong> Start entry with <code>- Title at Company, City (Dates)</code> or <code>- Title, Company (Dates)</code>.<br/>
                    Start bullet points with <code>&gt;</code> or <code>+</code>.
                </span>
            </div>

            <div class="cv-control-group">
                <label>Education</label>
                <textarea id="input-education" placeholder="e.g. - B.Sc. in Computer Engineering at Ege University (2022 - 2026)&#10;> Final year project: Study and Analysis of Subject...&#10;- High School Diploma at School Name (2018 - 2022)...">@Model.Education</textarea>
                <span class="cv-control-tip">
                    <strong>Tip:</strong> Start entry with <code>- Degree at University, City (Dates)</code>.<br/>
                    Start bullet points with <code>&gt;</code> or <code>+</code>.
                </span>
            </div>

            <div class="cv-control-group">
                <label>Skills</label>
                <textarea id="input-skills" placeholder="e.g. Microsoft Word, Microsoft PowerPoint, C#, SQL">@Model.Skills</textarea>
                <span class="cv-control-tip">Separate skills with commas or newlines.</span>
            </div>
        </div>

        <!-- Action Panel -->
        <div class="action-buttons">
            <button class="action-btn action-btn-primary" onclick="downloadPDF()">
                <span>📥</span> Download PDF
            </button>
        </div>
    </div>

    <!-- Right Pane: Live Preview -->
    <div class="cv-preview-container">
        
        <!-- SINGLE CLASSIC TEMPLATE (Matches reference image perfectly) -->
        <div class="cv-sheet font-serif" id="cv-sheet-main">
            <!-- CV Header -->
            <div class="cv-header">
                <h1 class="cv-name" id="cv-preview-name">@Model.FullName</h1>
                <div class="cv-job-title" id="cv-preview-jobtitle">Student</div>
                <div class="cv-divider"></div>
                <div class="cv-contact-row">
                    <span id="cv-preview-address">Izmir, Turkey</span> &bull; 
                    <span class="cv-phone" id="cv-preview-phone">@Model.Phone</span> &bull; 
                    <span class="cv-email" id="cv-preview-email">@Model.Email</span>
                </div>
                <div class="cv-divider"></div>
            </div>
            
            <!-- CV Body -->
            <div class="cv-body">
                <!-- Summary Section -->
                <div class="cv-section">
                    <div class="cv-section-title">Summary</div>
                    <div class="cv-about" id="cv-preview-about"></div>
                </div>
                
                <hr class="cv-divider-line" />
                
                <!-- Experience Section -->
                <div class="cv-section">
                    <div class="cv-section-title">Experience</div>
                    <div class="cv-experience" id="cv-preview-experience"></div>
                </div>
                
                <hr class="cv-divider-line" />
                
                <!-- Education Section -->
                <div class="cv-section">
                    <div class="cv-section-title">Education</div>
                    <div class="cv-education" id="cv-preview-education"></div>
                </div>
                
                <hr class="cv-divider-line" />
                
                <!-- Skills Section -->
                <div class="cv-section">
                    <div class="cv-section-title">Skills</div>
                    <div class="cv-skills-list" id="cv-preview-skills"></div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        // Real-time Content Syncing Helper
        function parseSkills(text) {
            if (!text) return [];
            return text.split(/[,\n]/)
                       .map(s => s.trim())
                       .filter(s => s.length > 0);
        }

        // Return Skills as Centered Dot-separated list (like in user's image)
        function formatSkillsList(text) {
            const skills = parseSkills(text);
            if (skills.length === 0) return '<p class="cv-para" style="color:var(--muted); font-style:italic; text-align:center;">No skills specified.</p>';
            return '<div class="cv-skills-centered">' + skills.join(' &bull; ') + '</div>';
        }

        // Special Parser for Experience & Education to format (Title/Company/Dates)
        function formatTextForPreview(text) {
            if (!text) return '<p class="cv-para" style="color:var(--muted); font-style:italic;">No information provided yet.</p>';
            const lines = text.split('\n');
            let html = '';
            let inList = false;

            for (let line of lines) {
                line = line.trim();
                
                // Parser for Job Title or Degree Title formatting
                // Assumes format: "- Job Title at Company, City (Date)" or "- Degree Title, University (Date)"
                if (line.startsWith('-') || line.startsWith('*') || line.startsWith('•')) {
                    if (inList) {
                        html += '</ul>';
                        inList = false;
                    }
                    
                    const cleanLine = line.replace(/^[-*•]\s*/, '');
                    
                    // Extract date: looking for (Date Range) at the end of the line
                    const dateMatch = cleanLine.match(/\(([^)]+)\)$/); // Matches something like (Jan 2023 - Feb 2024) at the end
                    let dateStr = '';
                    let mainInfo = cleanLine;
                    
                    if (dateMatch) {
                        dateStr = dateMatch[1];
                        mainInfo = cleanLine.substring(0, cleanLine.length - dateMatch[0].length).trim();
                    }

                    // Try to split title and place (e.g. by " at " or ", ")
                    let title = mainInfo;
                    let subtitle = '';
                    
                    if (mainInfo.includes(' at ')) {
                        const parts = mainInfo.split(' at ');
                        title = parts[0].trim();
                        subtitle = parts[1].trim();
                    } else if (mainInfo.includes(', ')) {
                        const parts = mainInfo.split(', ');
                        title = parts[0].trim();
                        subtitle = parts[1].trim();
                    }

                    // Render styled entry block
                    html += `
                        <div class="cv-entry" style="margin-top: 0.75rem; margin-bottom: 0.75rem;">
                            <div class="cv-entry-header" style="display:flex; justify-content:space-between; font-size:0.95rem; font-weight:700; margin-bottom: 0.15rem;">
                                <span class="cv-entry-title">${title}</span>
                                ${dateStr ? `<span class="cv-entry-date" style="font-weight:normal; color:var(--muted);">${dateStr}</span>` : ''}
                            </div>
                            ${subtitle ? `<div class="cv-entry-subtitle" style="font-style:italic; color:var(--muted); font-size:0.9rem; margin-bottom: 0.4rem;">${subtitle}</div>` : ''}
                        </div>
                    `;
                } else if (line.startsWith('>') || line.startsWith('+')) {
                    // Check for bullet list item details inside an entry
                    if (!inList) {
                        html += '<ul class="cv-list" style="margin-top:0.25rem; margin-bottom:0.5rem; padding-left:1.25rem;">';
                        inList = true;
                    }
                    const cleanItem = line.substring(1).trim();
                    html += `<li>${cleanItem}</li>`;
                } else {
                    if (inList) {
                        html += '</ul>';
                        inList = false;
                    }
                    if (line) {
                        html += `<p class="cv-para" style="margin: 0 0 0.5rem 0; line-height: 1.5; font-size: 0.95rem;">${line}</p>`;
                    } else {
                        html += '<div class="cv-spacing" style="height:0.5rem;"></div>';
                    }
                }
            }
            if (inList) {
                html += '</ul>';
            }
            return html;
        }

        function updatePreview() {
            const name = document.getElementById('input-fullname').value;
            const jobtitle = document.getElementById('input-jobtitle').value;
            const address = document.getElementById('input-address').value;
            const email = document.getElementById('input-email').value;
            const phone = document.getElementById('input-phone').value;
            const about = document.getElementById('input-aboutme').value;
            const skills = document.getElementById('input-skills').value;
            const education = document.getElementById('input-education').value;
            const experience = document.getElementById('input-experience').value;

            // Apply string updates to text elements
            document.getElementById('cv-preview-name').innerText = name || 'YOUR NAME';
            document.getElementById('cv-preview-jobtitle').innerText = jobtitle || 'JOB TITLE';
            document.getElementById('cv-preview-address').innerText = address || '123 Your Street, Your City';
            document.getElementById('cv-preview-phone').innerText = phone || '(0123) 456 7890';
            document.getElementById('cv-preview-email').innerText = email || 'yourname@email.co.uk';

            // Apply HTML formatted updates
            document.getElementById('cv-preview-about').innerHTML = formatTextForPreview(about);
            document.getElementById('cv-preview-education').innerHTML = formatTextForPreview(education);
            document.getElementById('cv-preview-experience').innerHTML = formatTextForPreview(experience);

            // Skills list centered dot format
            document.getElementById('cv-preview-skills').innerHTML = formatSkillsList(skills);
        }

        // Font selection handler
        function selectFont(fontClass, clickedBtn) {
            document.querySelectorAll('.font-btn').forEach(btn => btn.classList.remove('active'));
            clickedBtn.classList.add('active');

            const sheet = document.getElementById('cv-sheet-main');
            sheet.classList.remove('font-sans', 'font-serif', 'font-mono');
            sheet.classList.add(fontClass);
        }

        // High-resolution PDF Download function with zoom, shadow, and height/min-height compensation to prevent empty 2nd page
        function downloadPDF() {
            const activeSheet = document.getElementById('cv-sheet-main');
            const name = document.getElementById('input-fullname').value || 'resume';
            const filename = 'Resume_' + name.replace(/\s+/g, '_') + '.pdf';
            
            // Check if library loaded successfully
            if (typeof html2pdf === 'undefined') {
                alert('PDF generation engine is offline or still loading. Opening print dialog as a fallback. Please choose "Save as PDF" to download.');
                window.print();
                return;
            }

            // Save original styles
            const originalZoom = activeSheet.style.zoom || '0.68';
            const originalShadow = activeSheet.style.boxShadow;
            const originalHeight = activeSheet.style.height;
            const originalMinHeight = activeSheet.style.minHeight;
            const originalOverflow = activeSheet.style.overflow;
            
            // Temporarily set zoom to 1, strip shadow, and constrain height & min-height to fit A4
            activeSheet.style.zoom = '1';
            activeSheet.style.boxShadow = 'none';
            activeSheet.style.minHeight = '0';
            activeSheet.style.height = '296mm';
            activeSheet.style.overflow = 'hidden';

            const opt = {
                margin:       0,
                filename:     filename,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, logging: false },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            // Run html2pdf generation
            html2pdf().set(opt).from(activeSheet).save().then(() => {
                // Restore original styles
                activeSheet.style.zoom = originalZoom;
                activeSheet.style.boxShadow = originalShadow;
                activeSheet.style.height = originalHeight;
                activeSheet.style.minHeight = originalMinHeight;
                activeSheet.style.overflow = originalOverflow;
            }).catch(err => {
                console.error('PDF download error:', err);
                // Restore original styles
                activeSheet.style.zoom = originalZoom;
                activeSheet.style.boxShadow = originalShadow;
                activeSheet.style.height = originalHeight;
                activeSheet.style.minHeight = originalMinHeight;
                activeSheet.style.overflow = originalOverflow;
                alert('An error occurred during automatic PDF generation. Opening print dialog as fallback. Please select "Save as PDF".');
                window.print();
            });
        }

        // Initialize Page
        document.addEventListener('DOMContentLoaded', () => {
            updatePreview();

            // Attach listeners for live update
            const fieldIds = ['input-fullname', 'input-jobtitle', 'input-address', 'input-email', 'input-phone', 'input-aboutme', 'input-skills', 'input-education', 'input-experience'];
            fieldIds.forEach(id => {
                document.getElementById(id).addEventListener('input', updatePreview);
            });
        });
    </script>
}
