@model StudentWeb.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<style>
.auth-wrapper {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #eef2f7, #f8fafc);
}

.auth-card {
    width: 420px;
    background: white;
    border-radius: 16px;
    padding: 28px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.08);
}

.auth-title {
    font-size: 24px;
    font-weight: 700;
    text-align: center;
}

.auth-subtitle {
    text-align: center;
    color: #6b7280;
    margin-bottom: 20px;
}

.form-control {
    border-radius: 10px;
    padding: 12px;
}

.form-control:focus {
    border-color: #6366f1;
    box-shadow: 0 0 0 3px rgba(99,102,241,0.15);
}

.btn-primary {
    border-radius: 10px;
    padding: 12px;
    font-weight: 600;
    display: block;
    margin: 0 auto;
}
.form-content {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.field-group {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 20px;
}

.form-control {
    width: 100%;
    border-radius: 10px;
    padding: 8px 12px;
    height: 40px;
}

.form-control::placeholder {
    color: #9ca3af;
}
</style>

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-title">Welcome back</div>
        <div class="auth-subtitle">Sign in to your account</div>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="field-group">
    <input asp-for="Username"
           class="form-control"
           placeholder="Username" />
    <span asp-validation-for="Username" class="text-danger small"></span>
</div>

<div class="field-group">
    <input asp-for="Password"
           type="password"
           class="form-control"
           placeholder="Password" />
    <span asp-validation-for="Password" class="text-danger small"></span>
</div>

            <button class="btn btn-primary w-100">
                Sign In
            </button>
        </form>

        <div class="text-center mt-3">
            <a asp-action="Register">Create new account</a>
        </div>

    </div>
</div>